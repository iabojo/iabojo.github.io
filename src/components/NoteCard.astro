---
import TagList from './TagList.astro';
import { formatDate } from '../lib/content';

interface Props {
  slug: string;
  title?: string;
  date: Date;
  tags?: string[];
  heading?: 'h1' | 'h2';
}
const { slug, title, date, tags = [], heading = 'h2' } = Astro.props;
const Heading = heading;
---

<article class="note" id={slug}>
  {title && (
    <Heading class="note-title">
      {heading === 'h2' ? <a href={`/khawater/${slug}/`}>{title}</a> : title}
    </Heading>
  )}
  <div class="prose"><slot /></div>
  <footer class="note-meta">
    <a href={`/khawater/${slug}/`}>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </a>
    <TagList tags={tags} />
  </footer>
</article>
