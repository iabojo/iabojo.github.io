---
import TagList from './TagList.astro';
import { formatDate } from '../lib/content';

interface Props {
  slug: string;
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
}
const { slug, title, description = '', pubDate, tags = [] } = Astro.props;
---

<article class="post-row">
  <span class="perm">-rw-r--r--</span>
  <span class="title">
    <a href={`/blog/${slug}/`}>{title}</a>
    {description && <span class="meta">{description}</span>}
    <TagList tags={tags} />
  </span>
  <time class="date" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
</article>
