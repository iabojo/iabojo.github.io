---
interface Props {
  title: string;
  summary: string;
  stack: string[];
  status: 'active' | 'done' | 'planned';
  repoUrl?: string;
  releaseUrl?: string;
}
const { title, summary, stack, status, repoUrl, releaseUrl } = Astro.props;

const statusLabel: Record<string, string> = {
  active: '+ قيد التطوير',
  done: '+ مكتمل',
  planned: '~ مخطَّط له',
};
---

<div class={`project-block status-${status}`}>
  <span class="status-tag">{statusLabel[status]}</span>
  <h3>{title}</h3>
  <p class="summary">{summary}</p>
  {stack.length > 0 && (
    <ul class="stack-list">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  )}
  {(repoUrl || releaseUrl) && (
    <div class="project-links">
      {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer">الكود المصدري</a>}
      {releaseUrl && <a href={releaseUrl} target="_blank" rel="noopener noreferrer">تحميل APK</a>}
    </div>
  )}
</div>
