---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'مدونة مدونة أبو جودي — أنظمة BSD، أمن الشبكات، وتطبيقات أندرويد.',
  ogImage = '/og-default.png',
} = Astro.props;

const pageTitle = title === 'الرئيسية' ? 'مدونة أبو جودي' : `${title} · مدونة أبو جودي`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Fonts: Cairo (display), IBM Plex Sans Arabic (body), JetBrains Mono (code) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;800&family=IBM+Plex+Sans+Arabic:wght@400;500&family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="brand">مدونة أبو جودي <span aria-hidden="true" style="direction:ltr">// @iabojo</span></a>
      <nav class="main-nav" aria-label="التصفح الرئيسي">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>الرئيسية</a>
        <a href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>المدونة</a>
        <a href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects') ? 'page' : undefined}>المشاريع</a>
        <a href="/videos/" aria-current={Astro.url.pathname.startsWith('/videos') ? 'page' : undefined}>الفيديوهات</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>&copy; {new Date().getFullYear()} abojo</span>
    </div>
  </footer>
</body>
</html>
